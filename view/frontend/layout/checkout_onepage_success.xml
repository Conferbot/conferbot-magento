<?xml version="1.0"?>
<!--
/**
 * The order on the success page, reported to Conferbot as a purchase once
 * the widget has booted (widget.phtml drains window.ConferbotEvents).
 *
 * @author    Conferbot <support@conferbot.com>
 * @license   Open Software License (OSL 3.0)
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="before.body.end">
            <block name="conferbot.chat.order" before="conferbot.chat.widget"
                   template="Conferbot_Chat::order.phtml">
                <arguments>
                    <argument name="order_events" xsi:type="object">Conferbot\Chat\ViewModel\OrderEvents</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
