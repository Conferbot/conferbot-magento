<?php
/**
 * Conferbot widget loader - canonical snippet from the Conferbot dashboard,
 * with customer/store context passed as the third ConferbotWidget argument.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 *
 * @author    Conferbot <support@conferbot.com>
 * @license   Open Software License (OSL 3.0)
 */

/** @var \Conferbot\Chat\ViewModel\WidgetConfig $widgetConfig */
$widgetConfig = $block->getData('widget_config');

if (!$widgetConfig || !$widgetConfig->shouldRender()) {
    return;
}
?>
<script type="text/javascript">
  (function (d, s, id) {
    var js, el = d.getElementsByTagName(s)[0];
    if (d.getElementById(id)) return;
    js = d.createElement(s);
    js.async = true;
    js.src = '<?= $escaper->escapeJs($widgetConfig->getScriptUrl()) ?>';
    js.id = id;
    js.charset = 'UTF-8';
    el.parentNode.insertBefore(js, el);
    js.onload = function () {
      var options = <?= /* @noEscape */ $widgetConfig->getOptionsJson() ?>;
      window.ConferbotWidget(
        '<?= $escaper->escapeJs($widgetConfig->getBotId()) ?>',
        '<?= $escaper->escapeJs($widgetConfig->getEmbedType()) ?>',
        options
      );
    };
  })(document, 'script', 'conferbot-js');
</script>
